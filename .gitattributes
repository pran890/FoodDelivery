# Normalise line endings in the repository (LF), let Git convert on checkout.
* text=auto

# Windows-only scripts keep CRLF; shell scripts (CI runners, containers) must be LF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Binary files: never touch.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

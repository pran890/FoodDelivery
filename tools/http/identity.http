# Identity requests. Start the AppHost first:
#   dotnet run --project src/AppHost/FoodDelivery.AppHost
# Emails arrive in Mailpit: open its link in the Aspire dashboard.

@identity = https://localhost:7150
@email = asha@example.com

### Step 09: ask for a code. 202 whether the account exists or not
### Step 10: again within 60 s: 429 with Retry-After
POST {{identity}}/auth/otp/request
Content-Type: application/json

{ "email": "{{email}}" }

### Step 09: sign in with the code from Mailpit (creates the user the first time)
# @name verify
POST {{identity}}/auth/otp/verify
Content-Type: application/json

{ "email": "{{email}}", "code": "000000" }

### Read the user who just signed in (Development only until Step 11)
GET {{identity}}/users/{{verify.response.body.id}}

### Not a valid email (400)
POST {{identity}}/auth/otp/request
Content-Type: application/json

{ "email": "not-an-email" }

### Readiness: database and Redis. Redis down = "Degraded", still 200
GET {{identity}}/health

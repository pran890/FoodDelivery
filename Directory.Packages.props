<Project>
  <!--
    Central Package Management (CPM): every NuGet version is declared once, here.
    Projects reference packages with <PackageReference Include="X" /> and NO Version.
    A Version attribute in a .csproj is an error (NU1008).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning: if a package listed below also arrives indirectly
      (a dependency of a dependency), the version here wins. Useful for forcing
      a patched version of a vulnerable transitive package.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packages are added here as each learning step introduces one. -->

    <!-- Step 02: Aspire service discovery (version matched to the Aspire 13.6 templates) -->
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />

    <!-- Step 03: AppHost hosting integrations (declare containers in C#) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.1" />

    <!-- Step 03: plain client libraries (the sandbox reads connection strings by hand) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />

    <!-- Step 04: OpenTelemetry SDK, OTLP exporter and auto-instrumentation (keep all on one version) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
</Project>

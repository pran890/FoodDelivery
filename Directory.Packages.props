<Project>
  <!--
    Central Package Management (CPM): every NuGet version is declared once, here.
    Projects reference packages with <PackageReference Include="X" /> and NO Version.
    A Version attribute in a .csproj is an error (NU1008).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning: if a package listed below also arrives indirectly
      (a dependency of a dependency), the version here wins. Useful for forcing
      a patched version of a vulnerable transitive package.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packages are added here as each learning step introduces one. -->

    <!-- Step 02: Aspire service discovery (version matched to the Aspire 13.6 templates) -->
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />

    <!-- Step 03: AppHost hosting integrations (declare containers in C#) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.1" />

    <!-- Step 03: plain client libraries (the sandbox reads connection strings by hand) -->
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />

    <!-- Step 04: OpenTelemetry SDK, OTLP exporter and auto-instrumentation (keep all on one version) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />

    <!-- Step 05: HTTP resilience pipeline (Polly v8 underneath). 10.x = the .NET 10 line. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />

    <!-- Step 06: tests. xUnit v3 runs on Microsoft.Testing.Platform (switched on in global.json). -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- Step 08: EF Core for Postgres. Design is used only by the dotnet-ef tool (dotnet-tools.json). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Step 09: SMTP client for OTP emails (and "Testcontainers" for a Mailpit container in tests) -->
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />

    <!-- Step 11: creating and reading JWTs -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>
</Project>
